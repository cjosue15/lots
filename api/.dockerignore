# Installed and built inside the image (Linux), never copied from the Mac.
node_modules
dist
# A stale one makes `nest build` skip files.
*.tsbuildinfo
coverage

# Secrets come from the environment (--env-file or Dokploy), not the image.
.env
.env.*
!.env.example

# Not needed to build or run.
test
.claude
*.md
.DS_Store
*.log
Dockerfile
.dockerignore
