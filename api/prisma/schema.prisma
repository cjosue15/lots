generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CycleStatus {
  ACTIVE
  CLOSED
}

/// Which optional extra fields the form shows for an action (all optional).
enum DetailType {
  NONE
  APPLICATION // products (ActionLogProduct)
  IRRIGATION // humidity
  PEST_CHECK // result, chemicalApplied
  FERTILIZER_EVAL // result: WORKED | CHANGE
}

/// Units for doses and stock. Products are measured in L, KG or G; a dose can
/// use any unit of the same kind (volume: L, ML; weight: KG, G, MG).
enum DoseUnit {
  MG
  ML
  L
  KG
  G
}

/// INITIAL: stock counted in a greenhouse at go-live, loaded once by the
/// production inventory seed (PLAN §14, "Puesta en marcha").
enum StockMovementType {
  INITIAL
  ENTRY
  APPLICATION
  ADJUSTMENT
}

/// How a product was applied: through the irrigation system or sprayed.
enum ApplicationMethod {
  SYSTEM
  SPRAY
}

model Greenhouse {
  id   String @id @default(uuid())
  name String @unique

  lots            Lot[]
  stockMovements  StockMovement[]
  productMinimums ProductGreenhouse[]
}

model Lot {
  id           String  @id @default(uuid())
  greenhouseId String
  number       Int
  active       Boolean @default(true)

  greenhouse Greenhouse @relation(fields: [greenhouseId], references: [id])
  cycles     Cycle[]

  @@unique([greenhouseId, number])
}

model Phase {
  id    String @id @default(uuid())
  order Int    @unique
  name  String

  actions    Action[]
  actionLogs ActionLog[]
}

/// Template action. phaseId null = general action (does not move the phase).
model Action {
  id         String     @id @default(uuid())
  phaseId    String?
  name       String
  /// Stable key for the 3D view (worker animation); survives renames.
  code       String?    @unique
  order      Int
  detailType DetailType @default(NONE)
  active     Boolean    @default(true)

  phase      Phase?      @relation(fields: [phaseId], references: [id])
  actionLogs ActionLog[]

  @@index([phaseId])
}

/// Only one ACTIVE cycle per lot: partial unique index added by hand in the init migration.
model Cycle {
  id          String      @id @default(uuid())
  lotId       String
  number      Int
  startDate   DateTime    @db.Date
  endDate     DateTime?   @db.Date
  status      CycleStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime    @default(now())

  lot        Lot         @relation(fields: [lotId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])
  actionLogs ActionLog[]

  @@unique([lotId, number])
}

/// What was done on a given day. name and phaseId are copied from the action
/// so editing the template never alters history. actionId null = "Otra acción".
model ActionLog {
  id        String   @id @default(uuid())
  cycleId   String
  actionId  String?
  name      String
  phaseId   String?
  date      DateTime @db.Date
  details   Json?
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle    Cycle              @relation(fields: [cycleId], references: [id])
  action   Action?            @relation(fields: [actionId], references: [id])
  phase    Phase?             @relation(fields: [phaseId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  changes  ActionLogChange[]
  products ActionLogProduct[]

  @@index([cycleId, date])
}

/// Products used in an APPLICATION log, in the order they were entered.
model ActionLogProduct {
  id          String             @id @default(uuid())
  actionLogId String
  order       Int
  product     String
  dose        Float?
  /// Set whenever dose is.
  doseUnit    DoseUnit?
  method      ApplicationMethod?
  /// Catalog product; null only on logs from before the catalog. `product` keeps a copy of its name.
  productId   String?

  actionLog ActionLog      @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  catalog   Product?       @relation(fields: [productId], references: [id])
  movement  StockMovement?

  @@index([actionLogId])
  @@index([productId])
}

model ProductCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  products Product[]
}

/// Stock is never stored: it is the sum of the product's movements in each
/// greenhouse (PLAN §14). The catalog is shared by all greenhouses.
model Product {
  id         String   @id @default(uuid())
  name       String   @unique
  categoryId String
  /// L, KG or G. Fixed once created.
  unit       DoseUnit
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  category     ProductCategory     @relation(fields: [categoryId], references: [id])
  movements    StockMovement[]
  applications ActionLogProduct[]
  minimums     ProductGreenhouse[]
}

/// A product's minimum stock in one greenhouse; no row means 0.
model ProductGreenhouse {
  productId    String
  greenhouseId String
  minStock     Float  @default(0)

  product    Product    @relation(fields: [productId], references: [id])
  greenhouse Greenhouse @relation(fields: [greenhouseId], references: [id])

  @@id([productId, greenhouseId])
}

/// Stock ledger. quantity is signed (positive in, negative out) in the product's unit.
/// Each movement belongs to one greenhouse; an APPLICATION takes its lot's.
model StockMovement {
  id                 String            @id @default(uuid())
  productId          String
  greenhouseId       String
  date               DateTime          @db.Date
  quantity           Float
  type               StockMovementType
  /// Price per product unit; required on INITIAL and ENTRY, null otherwise.
  unitCost           Float?
  /// Set on APPLICATION; removed with the applied product.
  actionLogProductId String?           @unique
  reason             String?
  userId             String
  createdAt          DateTime          @default(now())

  product          Product           @relation(fields: [productId], references: [id])
  greenhouse       Greenhouse        @relation(fields: [greenhouseId], references: [id])
  actionLogProduct ActionLogProduct? @relation(fields: [actionLogProductId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id])

  @@index([productId, greenhouseId, date])
}

/// Audit trail: one row per edit, written in the same transaction.
model ActionLogChange {
  id          String   @id @default(uuid())
  actionLogId String
  userId      String
  changedAt   DateTime @default(now())
  before      Json
  after       Json

  actionLog ActionLog @relation(fields: [actionLogId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([actionLogId])
}

/// Local copy of the Supabase user, created on first login. The role is NOT
/// stored here: it always comes from application_memberships.
model User {
  id          String   @id @default(uuid())
  authId      String   @unique
  displayName String
  email       String
  createdAt   DateTime @default(now())

  cycles         Cycle[]
  actionLogs     ActionLog[]
  changes        ActionLogChange[]
  stockMovements StockMovement[]
}
