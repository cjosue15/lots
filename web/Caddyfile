:80 {
    # Angular build output (dist/web/browser)
    root * /app

    encode zstd gzip

    # Angular puts an 8-character hash in the name of each build file:
    # a new deploy gives new names, so they can be kept for a year.
    @hashed path_regexp -[A-Za-z0-9_-]{8}\.(js|css|woff2)$
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # Everything else (index.html, app routes, the service worker, the manifest,
    # icons) always checks with the server; if nothing changed it answers 304.
    # Otherwise an old index.html could point to files the new deploy removed.
    @fresh not path_regexp -[A-Za-z0-9_-]{8}\.(js|css|woff2)$
    header @fresh Cache-Control "no-cache"

    # SPA: any route without a file serves index.html.
    try_files {path} /index.html
    file_server
}
